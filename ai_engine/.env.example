# AI engine settings. Put REAL values in backend/.env: the backend reads them and passes them to the AI engine.
LLM_PROVIDER=mock            # openai | gemini | mock
LLM_MODEL=gpt-4o-mini        # gemini example: gemini-2.0-flash
EMBEDDING_PROVIDER=mock      # openai | local | mock
EMBEDDING_MODEL=text-embedding-3-small   # local example: BAAI/bge-m3 (dim 1024)
EMBEDDING_DIM=1536
OPENAI_API_KEY=
GEMINI_API_KEY=

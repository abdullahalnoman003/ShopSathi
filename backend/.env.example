APP_ENV=local
DATABASE_URL=postgresql+psycopg://shopsathi:shopsathi_local@localhost:5432/shopsathi
TEST_DATABASE_URL=postgresql+psycopg://shopsathi:shopsathi_local@localhost:5432/shopsathi_test
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3000
# Public base URL of this backend (product photo URLs are built from it)
BACKEND_PUBLIC_URL=http://localhost:8000

# Uploaded media: folder (git-ignored) served at /media, and max size per image
MEDIA_ROOT=media
MAX_UPLOAD_MB=5

# CSV/Excel product import limits
MAX_IMPORT_MB=2
MAX_IMPORT_ROWS=1000

# Auth. Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_EXPIRE_MINUTES=60

# Redis rate limits (fixed window)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
RESET_RATE_LIMIT=5
RESET_RATE_WINDOW_SECONDS=900

# SMTP. Leave SMTP_HOST empty in development: emails (with reset links) are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ShopSathi <no-reply@shopsathi.local>
SMTP_USE_TLS=true

# CLI only: password for `create-admin` (else prompted) and for demo owners in `seed` (else generated and printed once)
ADMIN_PASSWORD=
DEMO_PASSWORD=

# Facebook Page connection (https://developers.facebook.com/apps). Leave empty until you have a Meta app:
# the "Facebook Page" settings page then explains what is missing.
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_API_VERSION=v21.0
# This backend's callback, registered in the Meta app under Facebook Login > Valid OAuth Redirect URIs
FB_OAUTH_REDIRECT_URI=
# Encrypts Page tokens in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it secret and back it up: tokens cannot be decrypted without it (Pages would have to be reconnected).
FB_TOKEN_ENCRYPTION_KEY=
# Where the browser returns after Facebook login (empty = FRONTEND_ORIGIN)
FRONTEND_URL=http://localhost:3000
# Messenger webhook: Callback URL <public https URL>/api/v1/webhooks/messenger, Verify token = this value.
# Choose any long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
FB_VERIFY_TOKEN=
# Sending replies: attempts for temporary Facebook errors, and the pause between attempts (seconds)
FB_SEND_MAX_ATTEMPTS=3
FB_SEND_RETRY_DELAY_SECONDS=0.5
# BACKEND_PUBLIC_URL (above) must be a public HTTPS address in production: Facebook downloads product photos from it
# Dev/test only (backend/scripts/fake_facebook.py): leave unset for the real Facebook
# FB_GRAPH_BASE_URL=http://localhost:8099
# FB_DIALOG_BASE_URL=http://localhost:8099

# AI engine: the backend passes these to shopsathi_ai
LLM_PROVIDER=mock                      # openai | gemini | mock. mock = rule-based test double, NOT real AI
LLM_MODEL=gpt-4o-mini                  # gemini example: gemini-2.0-flash (needs: pip install "shopsathi-ai[llm]")
EMBEDDING_PROVIDER=mock                # openai | local | mock. mock = offline test double, NOT real search
EMBEDDING_MODEL=text-embedding-3-small # local example: BAAI/bge-m3 (needs: pip install "shopsathi-ai[local]")
EMBEDDING_DIM=1536                     # must match the model (bge-m3 = 1024) and the embedding_chunks column
OPENAI_API_KEY=
GEMINI_API_KEY=
# USD per 1M input tokens by model name (JSON), used to estimate cost in ai_usage_logs
AI_COST_RATES={"text-embedding-3-small": {"input_per_1m": 0.02}, "gpt-4o-mini": {"input_per_1m": 0.15, "output_per_1m": 0.60}}
# Chat pipeline: Redis short-term memory (last N turns, TTL) and retrieval thresholds
CHAT_MEMORY_TURNS=8
CHAT_MEMORY_TTL_SECONDS=21600
RAG_MIN_SCORE=0.2
RAG_MIN_PRODUCT_SCORE=0.3
# The AI flags a chat for a person when its confidence in what the customer wants is below this (0-1)
AI_CONFIDENCE_THRESHOLD=0.5
# An unfinished order collection (fields asked but not all given) is forgotten after this many hours
ORDER_PENDING_TTL_HOURS=24
# The longest date range (in days) the Reports page may ask for
REPORT_MAX_RANGE_DAYS=366
# Tests only: run background tasks inline
CELERY_TASK_ALWAYS_EAGER=false
